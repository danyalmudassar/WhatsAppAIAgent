OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_API_KEY=
MEMORY_PATH=data/memory.db
MEMORY_KEY=replace-with-a-fernet-key
APP_ADMIN_TOKEN=replace-with-a-long-random-admin-token
PORT=8000
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_ENDPOINT=https://api.whatsapp.com/agent/v1
WHATSAPP_AUTH_HEADER=Authorization
WHATSAPP_AUTH_SCHEME=Bearer
WHATSAPP_POLL_INTERVAL=1
RESPONSE_LANGUAGE=roman_urdu
MAX_TOOL_SECONDS=15
MAX_RESPONSE_CHARS=3000
WORKSPACE_ROOT=.
WHATSAPP_POLL_INTERVAL=1
WHATSAPP_RETRY_BASE_SECONDS=2
WHATSAPP_RETRY_MAX_SECONDS=60
MAX_REQUEST_BYTES=1048576
DASHBOARD_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=86400
EVENT_RETENTION=1000
OWNER_USERNAME=admin
OWNER_PASSWORD_HASH=
DECISION_ROUTER_ENABLED=false
DECISION_BACKENDS=laya,openjev,jev
DECISION_TIMEOUT_SECONDS=2.0
DECISION_CONFIDENCE_THRESHOLD=0.75
LAYA_MODEL=convaiinnovations/laya-multilingual
OPENJEV_URL=
JEV_URL=
JEV_API_KEY=
# Dashboard data remains encrypted in MEMORY_PATH on the persistent volume.
# Set DASHBOARD_ORIGIN to the deployed Next.js dashboard URL in production.
